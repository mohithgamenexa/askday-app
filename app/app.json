{
  "expo": {
    "name": "Askday",
    "slug": "askday",
    "scheme": "askday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F5FB",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5FB"
    },
    "ios": {
      "bundleIdentifier": "app.askday.ios",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:askday.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile or group photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.askday.android",
      "adaptiveIcon": {
        "backgroundColor": "#4B3BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "askday.app",
              "pathPrefix": "/j/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Askday",
      "themeColor": "#F6F5FB",
      "backgroundColor": "#F6F5FB"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F5FB"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4B3BFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile or group photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}