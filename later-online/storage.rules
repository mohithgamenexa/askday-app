rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }
    match /groups/{gid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isImage()
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(gid)).data.memberIds;
    }
  }
}
