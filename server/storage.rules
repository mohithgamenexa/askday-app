rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: anyone signed in can see them; only you can upload yours (images under 5 MB).
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }

    // Photos and voice notes on answers: only group members can see them; you can only upload your own.
    match /answers/{gid}/{qid}/{file} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(gid)).data.memberIds;
      }
      allow read: if isMember();
      allow write: if isMember()
        && file.matches(request.auth.uid + '[.](jpg|m4a)')
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
